# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# Usage: make -f Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_TOOLCHAIN=<toolchain> \
#    [INSTALL_PREFIX=<prefix>] [target]
#
# Targets:
#   all              Build static libraries (libcrypto.a, libssl.a) and test ELF, then stage via install
#   install          Stage built artifacts into LIB_OUT/INCLUDE_OUT/TEST_OUT
#   clean            Remove build artifacts
#
# Note: the functional test (boot the test ELF under nanvixd) is driven
# by .nanvix/z.py (`./z test`); there is no `test` target here.

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is ONLY called by z.py
# 2. Build mode ALWAYS runs in Docker
# 3. Build ALWAYS runs before test

.DEFAULT_GOAL=all
EXE = .elf

# Test program (inline-generated; kept here because adding source files
# under .nanvix/ is out of scope for the docker-build-only refactor).
TEST_SRC := openssl_nanvix_test.c
TEST_ELF := openssl_nanvix_test$(EXE)

# Marker file produced by ./Configure.
CONFIGURED_MARKER := .nanvix-configured

_NANVIX_DOCKER_BUILD_GOALS := all build install $(CONFIGURED_MARKER) $(TEST_ELF)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined.
_REQUIRED := PLATFORM \
    PROCESS_MODE \
    MEMORY_SIZE \
    NANVIX_HOME \
    NANVIX_TOOLCHAIN \
    NANVIX_ROOT \
    OUT_DIR \
    DIST_DIR \
    LIB_OUT \
    INCLUDE_OUT \
    TEST_OUT
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH := $(abspath $(NANVIX_HOME))

# INSTALL_PREFIX: the prefix baked into compiled artifacts (OPENSSLDIR, etc.).
# Local builds default to SYSROOT_PATH; z.py overrides to /sysroot so that
# release artifacts don't contain ephemeral runner paths.
INSTALL_PREFIX ?= $(SYSROOT_PATH)

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc),)
    $(error Nanvix toolchain not found at $(NANVIX_TOOLCHAIN))
  endif
endif

CC := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc
AR := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-ar
RANLIB := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-ranlib
CXX := $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-g++
NANVIX_LDFLAGS := -T$(SYSROOT_PATH)/lib/user.ld -static -Wl,-z,noexecstack
NANVIX_LIBS := -Wl,--start-group \
  $(SYSROOT_PATH)/lib/libnvx_crt0.a \
  $(SYSROOT_PATH)/lib/libposix.a \
  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libc.a \
  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libm.a \
  -Wl,--end-group

# Configure environment and options.
CONFIGURE_ENV = \
	AR="$(AR)" \
	CC="$(CC)" \
	CXX="$(CXX)" \
	RANLIB="$(RANLIB)" \
	CFLAGS="-I$(NANVIX_TOOLCHAIN)/usr/include/"

# The 'nanvix' target is defined in Configurations/10-main.conf.
CONFIGURE_OPTS = \
	--openssldir="$(INSTALL_PREFIX)" \
	--prefix="$(INSTALL_PREFIX)" \
	nanvix \
	no-shared \
	threads \
	no-dso \
	no-apps \
	no-docs \
	no-rdrand \
	no-posix-io \
	no-asm \
	no-ui-console

# ===========================================================================
# Build Targets
# ===========================================================================

all: build $(TEST_ELF) install

$(CONFIGURED_MARKER):
	$(CONFIGURE_ENV) ./Configure $(CONFIGURE_OPTS)
	touch $(CONFIGURED_MARKER)

build: $(CONFIGURED_MARKER)
	$(MAKE) -j$$(nproc) all

# Generate the inline test program source.
$(TEST_SRC):
	@echo 'Generating $(TEST_SRC)...'
	@printf '%s\n' \
	  '#include <stdio.h>' \
	  '#include <string.h>' \
	  '#include <openssl/opensslv.h>' \
	  '#include <openssl/sha.h>' \
	  '#include <openssl/bn.h>' \
	  'int main(void) {' \
	  '    unsigned char md[SHA256_DIGEST_LENGTH];' \
	  '    const char *msg = "hello nanvix";' \
	  '    SHA256((const unsigned char *)msg, strlen(msg), md);' \
	  '    BIGNUM *bn = BN_new();' \
	  '    if (!bn) { printf("OPENSSL_TEST: FAIL bn_new\n"); return 1; }' \
	  '    BN_set_word(bn, 12345);' \
	  '    char *s = BN_bn2dec(bn);' \
	  '    if (!s || strcmp(s, "12345") != 0) {' \
	  '        printf("OPENSSL_TEST: FAIL bn value\n"); return 1; }' \
	  '    OPENSSL_free(s);' \
	  '    BN_free(bn);' \
	  '    printf("OPENSSL_TEST: PASS version=%s\n", OPENSSL_VERSION_TEXT);' \
	  '    return 0;' \
	  '}' > $@

# Build artefacts produced by the autotools-generated Makefile during
# 'build'. Declaring them as real prereqs of $(TEST_ELF) gives proper
# timestamp-based staleness detection (the test ELF relinks if any of the
# libs/headers change); the empty/error stub recipe yields a helpful
# message when 'build' has not been run yet.
libcrypto.a libssl.a include/openssl/opensslv.h:
	@echo "  FAIL: $@ not found; run 'build' first"; exit 1

$(TEST_ELF): $(TEST_SRC) libcrypto.a libssl.a include/openssl/opensslv.h
	$(CC) -O2 \
	  -I$(CURDIR)/include \
	  $(TEST_SRC) \
	  -L$(CURDIR) -lssl -lcrypto \
	  $(NANVIX_LDFLAGS) $(NANVIX_LIBS) \
	  -o $@

# Stage built artifacts into the release/test output tree so that
# `./z release` (which packages release_dir()) can find them.
install: libcrypto.a libssl.a include/openssl/opensslv.h $(TEST_ELF)
	@mkdir -p $(LIB_OUT) $(INCLUDE_OUT)/openssl $(TEST_OUT)
	cp -f libcrypto.a libssl.a   $(LIB_OUT)/
	cp -f include/openssl/*.h    $(INCLUDE_OUT)/openssl/
	cp -f $(TEST_ELF)            $(TEST_OUT)/

# ===========================================================================
# Clean
# ===========================================================================

clean:
	-$(MAKE) clean 2>/dev/null || true
	rm -f $(CONFIGURED_MARKER) $(TEST_SRC) $(TEST_ELF) Makefile
	rm -rf $(OUT_DIR) dist/

.PHONY: all build install clean
